{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "MaxSizeMB": 20,
    "AllowedExtensions": [ ".txt", ".pdf", ".png", ".jpg", ".jpeg", ".zip", ".docx", ".xlsx" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
