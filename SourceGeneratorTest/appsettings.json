{
  "AllowedHosts": "*",
  "McpAuth": {
    "HeaderName": "X-API-Key",
    "Keys": [
      {
        "Name": "read-only",
        "Key": "dev-mcp-read-key",
        "Roles": [ "mcp.read" ]
      },
      {
        "Name": "full-access",
        "Key": "dev-mcp-write-key",
        "Roles": [ "mcp.read", "mcp.write" ]
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "MaxSizeMB": 20,
    "AllowedExtensions": [ ".txt", ".pdf", ".png", ".jpg", ".jpeg", ".zip", ".docx", ".xlsx" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
